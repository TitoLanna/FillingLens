# Copy to .env.local and edit.

# Use the in-browser mock (true) or your real API (false).
VITE_USE_MOCK=true

# Base URL of the API GATEWAY (not the backend). Leave empty in dev: Vite proxies /v1 to http://localhost:8080.
# Set it for a deployed build, e.g. https://api.yourdomain.com. The gateway's ALLOWED_ORIGINS must include the UI's origin.
VITE_API_BASE_URL=
