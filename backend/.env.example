# Copy to .env (read by filinglens/config.py, no dotenv library).
HOST=127.0.0.1
PORT=8000
DB_PATH=data/filinglens.db
CORS_ORIGIN=*
# Pipeline config used by /v1/query: baseline (dense only) or hybrid (BM25 + dense + RRF).
PIPELINE=baseline
# Refuse when no enabled retriever clears its threshold.
REFUSAL_MIN_BM25=0.3
REFUSAL_MIN_DENSE=0.2
# SEC requires a descriptive User-Agent with contact info.
SEC_USER_AGENT=FilingLens research you@example.com

# Embeddings: "hash" (offline placeholder) or "voyage" (needs VOYAGE_API_KEY).
# Changing provider/model re-embeds documents on the next ingest.
EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Generator: "anthropic" (needs ANTHROPIC_API_KEY; default when the key is set) or "stub".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# USD per million tokens, copied from the provider's pricing page. 0 = cost not tracked.
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

# Model for the eval judge and golden-question generator (defaults to LLM_MODEL).
JUDGE_MODEL=

# --- API gateway (python3 -m gateway). The browser talks to this, never to the backend. ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
UPSTREAM_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed by CORS. Add your deployed UI origin.
ALLOWED_ORIGINS=http://localhost:5173
# Bearer token for admin routes (/v1/ingest, /v1/retrieve, running evals). Empty = those routes are off.
ADMIN_TOKEN=
RATE_QUERY_PER_MIN=10
RATE_READ_PER_MIN=120
MAX_INFLIGHT_QUERIES=8
MAX_BODY_BYTES=16384
UPSTREAM_TIMEOUT=130
# true only behind a reverse proxy you control: then the client IP is the last X-Forwarded-For entry.
TRUST_PROXY=false

# Where downloaded filings are cached (raw HTML). Re-ingesting reuses these instead of re-downloading.
RAW_DIR=data/raw
